# PTF-SITE-005. Committed authority artifacts check out with LF on every
# platform, so the bytes a reviewer approved are the bytes every clone gets.
#
# The release contract's package digest is line-ending independent
# (assemble_netlify_bundle.content_sha256), so a CRLF checkout no longer breaks
# the gate. This file removes the ambiguity a layer earlier instead of relying
# on that tolerance: a data artifact under version control should not change
# shape depending on who cloned it.
#
# Deliberately narrow. Source files keep the repository's existing behaviour --
# widening this to "* text=auto eol=lf" would rewrite thousands of files and
# bury the change that matters.

launch_packages/**/*.json    text eol=lf
launch_packages/**/*.csv     text eol=lf
deploy/**/*.json             text eol=lf
deploy/**/*.toml             text eol=lf

# Netlify control-file SOURCES, copied byte-for-byte into the published bundle
# as site/_headers and site/_redirects. Their names defeat extension globs --
# "redirects" has none and ".production"/".preview" are not matched above -- so
# they checked out with CRLF and the assembled bundle hashed differently per
# clone. Two files of 309 differing is enough to make the release name
# unreproducible and a byte-comparison of two builds meaningless.
deploy/netlify/headers.*     text eol=lf
deploy/netlify/redirects     text eol=lf

# PTF-POLICY-P0-001. The adversarial policy fixtures are the verified bytes of
# the research package, and a test asserts their sha256 against the hash in
# that package's MANIFEST. Without this line a Windows clone checks them out
# with CRLF, the hash no longer matches, and the natural "fix" is to weaken the
# assertion -- which would remove the only guarantee that the fixtures are the
# package's and not someone's edit.
tests/pettripfinder/policy/fixtures/*.json    text eol=lf

# PTF-FACTORY-THROUGHPUT-HARDENING-001. The current-state pins the test suites
# read are reviewed data artifacts on the same footing as the authority files.
tests/pettripfinder/pins/*.json    text eol=lf
