{
  "$id": "ptf-prod003-approvals/1.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Committed, deterministic approval contract binding each worker-promotion approval to a frozen Gate-1 result_hash. No approval promotes a record on its own; a promotion stage re-derives the Gate-1 manifest and rejects any stale hash or a record with no approval. Operator and approval_date are human-supplied; no field may be generated from a wall clock, and no raw model output or credential may be stored.",
  "properties": {
    "approvals": {
      "description": "Recorded, individually hash-bound approval decisions. Empty until a human records decisions.",
      "items": {
        "additionalProperties": false,
        "if": {
          "properties": {
            "decision": {
              "const": "APPROVED_FOR_PROMOTION"
            }
          }
        },
        "properties": {
          "approval_date": {
            "minLength": 1,
            "type": "string"
          },
          "decision": {
            "enum": [
              "APPROVED_FOR_PROMOTION",
              "HOLD_FOR_MANUAL_REVIEW",
              "REJECTED",
              "SUPERSEDED",
              "APPROVED_TIERED_FEE_OMITTED"
            ],
            "type": "string"
          },
          "gate1_route": {
            "enum": [
              "READY",
              "REVIEW",
              "RETRY",
              "REJECTED"
            ],
            "type": "string"
          },
          "listing_key": {
            "minLength": 1,
            "type": "string"
          },
          "listing_name": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "operator": {
            "minLength": 1,
            "type": "string"
          },
          "preserved_fee_amounts": {
            "description": "The complete tiered fee amounts preserved verbatim because the scalar production field is omitted.",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "result_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source_url": {
            "minLength": 1,
            "type": "string"
          },
          "verification_date": {
            "minLength": 1,
            "type": "string"
          },
          "waived_reason_codes": {
            "description": "PTF-INVENTORY-001: reason codes waived by APPROVED_TIERED_FEE_OMITTED. Only STRUCTURED_FEE_REQUIRED may ever appear.",
            "items": {
              "enum": [
                "STRUCTURED_FEE_REQUIRED"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "listing_key",
          "listing_name",
          "result_hash",
          "source_url",
          "verification_date",
          "gate1_route",
          "decision",
          "operator",
          "approval_date"
        ],
        "then": {
          "properties": {
            "gate1_route": {
              "const": "READY"
            }
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "bound_to": {
      "additionalProperties": false,
      "properties": {
        "frozen_worker_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "gate1_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "gate1_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "frozen_worker_commit",
        "gate1_commit",
        "gate1_manifest_sha256"
      ],
      "type": "object"
    },
    "market": {
      "minLength": 1,
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "pending_candidates": {
      "description": "Launch-safe worker candidates awaiting per-record human review. Identity only -- never a decision, operator, or date.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "gate1_route": {
            "enum": [
              "READY",
              "REVIEW",
              "RETRY",
              "REJECTED"
            ],
            "type": "string"
          },
          "listing_key": {
            "minLength": 1,
            "type": "string"
          },
          "listing_name": {
            "minLength": 1,
            "type": "string"
          },
          "result_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source_url": {
            "minLength": 1,
            "type": "string"
          },
          "verification_date": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "listing_key",
          "listing_name",
          "result_hash",
          "source_url",
          "verification_date",
          "gate1_route"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "ptf-prod003-approvals/1.0"
    }
  },
  "required": [
    "schema",
    "market",
    "approvals"
  ],
  "title": "PetTripFinder PROD-003 worker-promotion approval manifest",
  "type": "object"
}
