     "document_bytes": 87692,
     "fetched_at": "2026-09-12T22:43:51Z",
     "sentence": "While we welcome service animals, unfortunately pets (including emotional support animals) are not permitted at our hotel."
    },
    {
     "url": "https://www.admiralsquartersmotel.com/faq",
     "document_sha256": "e8c890513cafbcba20de3d3cff8be756753756590c6f0ffa78436d2bcddedc87",
     "document_bytes": 41162,
     "fetched_at": "2026-09-12T22:43:51Z",
     "sentence": "We welcome service animals as well as well-behaved dogs with a fee."
    },
    {
