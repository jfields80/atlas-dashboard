    {
     "url": "https://www.admiralsquartersmotel.com/rooms/policies",
     "document_sha256": "6bcf4be4132ff20368a73c708aa6d9eca01ca2117acd0a1d1a0b2a79da5d7beb",
     "document_bytes": 31061,
     "fetched_at": "2026-09-12T22:43:51Z",
     "sentence": "When bringing your pet, please call the motel to confirm the pet and to confirm payment of the pet fee."
    },
    {
     "url": "https://www.admiralsquartersmotel.com/rooms/policies",
     "document_sha256": "6bcf4be4132ff20368a73c708aa6d9eca01ca2117acd0a1d1a0b2a79da5d7beb",
     "document_bytes": 31061,
     "fetched_at": "2026-09-12T22:43:51Z",
     "sentence": "The fee for pets is $50."
    },
    {
     "url": "https://www.admiralsquartersmotel.com/rooms/policies",
     "document_sha256": "6bcf4be4132ff20368a73c708aa6d9eca01ca2117acd0a1d1a0b2a79da5d7beb",
