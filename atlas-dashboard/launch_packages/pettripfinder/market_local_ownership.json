 "shared_write_allowlist": {
  "what": "Shared roots every zone may write. Each is a generated-report location Regression V2 already classifies GENERATED_REPORT_ONLY (a report is an output, never an input to authority), or the gitignored data/ tree.",
  "roots": [
   "data/",
   "launch_packages/pettripfinder/reports/",
