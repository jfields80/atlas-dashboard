  ]
 },
 "allowed_subprocess": {
  "what": "The only subprocess a market-local helper may spawn: read-only git plumbing/porcelain, and pytest over the repository (a helper that runs the market's own lanes). The argv must resolve statically to a literal head; anything else is an unresolved dynamic dependency and fails the proof.",
  "git_readonly_subcommands": ["status", "diff", "rev-parse", "show", "ls-files", "ls-tree", "log", "grep", "hash-object", "check-ignore", "describe", "branch", "merge-base"],
  "python_modules": ["pytest", "scripts.pettripfinder.regression_lanes", "scripts.pettripfinder.regression_delta"]
 },
