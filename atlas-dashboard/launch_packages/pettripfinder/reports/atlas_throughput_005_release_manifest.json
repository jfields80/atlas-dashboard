{
 "schema": "ptf-release-manifest-contract/1.0",
 "manifest_schema": "ptf-release-manifest/1.0",
 "canonical_serialisation": "sealed_market_package.canonical_json; the release digest is sha256 over the canonical manifest",
 "membership_rule": "participation is an ARGUMENT to release_manifest(); by the time the document exists the decision is inside the bytes that get hashed",
 "fields": [
  {
   "field": "schema / release_schema_version",
   "shape": "ptf-release-manifest/1.0",
   "why": "the manifest's own contract version"
  },
  {
   "field": "coordinator_version",
   "shape": "ptf-release-coordinator/1.0",
   "why": "which coordinator composed it"
  },
  {
   "field": "created_at",
   "shape": "ISO-8601 Z",
   "why": "when it was staged"
  },
  {
   "field": "parent_release_digest",
   "shape": "sha256:...",
   "why": "the release this one is composed FROM"
  },
  {
   "field": "source_commit",
   "shape": "40 hex",
   "why": "the tree that staged it (never the membership authority)"
  },
  {
   "field": "context / base_url / anchor_market",
   "shape": "production | preview",
   "why": "what the bundle is FOR"
  },
  {
   "field": "participating_markets",
   "shape": "sorted market ids",
   "why": "FINAL membership, present before hashing"
  },
  {
   "field": "participation_sha256",
   "shape": "sha256 of the participation document",
   "why": "the founder decision that admits them"
  },
  {
   "field": "markets[]",
   "shape": "market_id, package_digest, build_input_key, bundle_digest, validation_receipt_digest, fragment_source, fragment_digest, profile_count, route_count",
   "why": "one row per participating market: where its bytes came from and what it publishes"
  },
  {
   "field": "intended_delta / intended_delta_digest",
   "shape": "the package's declared delta",
   "why": "what this release means to change"
  },
  {
   "field": "global_artifacts",
   "shape": "{path: sha256}",
   "why": "every release-global file this release regenerated"
  },
  {
   "field": "global_index_digest",
   "shape": "sha256:...",
   "why": "the composed release index (003's lightweight index)"
  },
  {
   "field": "deployment_artifact_digest",
   "shape": "sha256 hex",
   "why": "bundle_digest(file_hashes(site)) \u2014 the deployable identity"
  },
  {
   "field": "sitemap_sha256 / total_profiles / sitemap_route_count / total_html_pages / total_files",
   "shape": "counts",
   "why": "what the artifact contains"
  },
  {
   "field": "validation_policy_version",
   "shape": "ptf-bundle-validation/1.0",
   "why": "the bundle validation policy the reused bundles were validated under"
  },
  {
   "field": "assembler_digest / builder_digest",
   "shape": "sha256 of the module sources",
   "why": "what composed it"
  },
  {
   "field": "status",
   "shape": "SOURCE_READY | CANDIDATE_STAGED | FOUNDER_AUTHORIZED | LIVE | FAILED | ABANDONED",
   "why": "where in the lifecycle it is"
  }
 ],
 "example_candidate_digest": "sha256:25b69be224b34ff42a4b96845173e50834f0f4c80773774d5416df985b0e6b96",
