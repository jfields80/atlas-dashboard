  "deployment_artifact_digest": "437439f275b2f276fa2969adbc0ddc694f0cf1ce23bffcf9e19dd44c24745427",
  "intended_delta_digest": "sha256:c7b7fb29b5c91001d788562887aa32d0e41276989651f02749fab68ef7fbe940",
  "parent_release_digest": "sha256:637e228fc74392b6c7617735d3a38cd282ad71f02b8e7413a144ae509ff73201",
  "state": "VALID"
 }
}
