# PetTripFinder Columbus — PRODUCTION response headers (Netlify `_headers` format).
# Source of truth (tracked, tested). The assembler copies this to site/_headers
# for the `production` context. Lines beginning with `#` are comments.
#
# HSTS (Strict-Transport-Security) is intentionally NOT emitted in Stage A. It is
# activated only AFTER HTTPS/TLS is confirmed on the live apex domain, as a
# separate reviewed step (no preload, no includeSubDomains without its own
# review). See docs/pettripfinder/DEPLOYMENT_RUNBOOK.md.
#
# Content-Security-Policy is REPORT-ONLY during the pilot. The bundle contains
# inline <script> (the /go/ client redirects + the home analytics/filter script)
# and inline style="" attributes, so an ENFORCED strict CSP would break them.
# Enforcement is a separate follow-up that first hashes/externalizes inline JS
# and removes inline styles. No reporting endpoint is invented here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
  Cache-Control: public, max-age=0, must-revalidate

# CSS is not content-hashed, so it must NOT be immutably cached. Short cache with
# mandatory revalidation until asset content-hashing is added (later).
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

# XML / robots / llms are short-cached so edits propagate quickly.
/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

/llms.txt
  Cache-Control: public, max-age=300, must-revalidate
